# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# LSPosed entry point and hook classes must survive shrinking/renaming:
# assets/xposed_init names HookEntry by its fully-qualified name.
-keep class io.laelaps.zuitweaks.xposed.** { *; }

# The settings schema is read from inside the hooked processes too, and BuildConfig
# supplies the package name XSharedPreferences opens.
-keep class io.laelaps.zuitweaks.settings.** { *; }
-keep class io.laelaps.zuitweaks.BuildConfig { *; }
