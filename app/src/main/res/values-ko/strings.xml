    <string name="set_transient_title">플로팅 바</string>
    <string name="set_transient_summary">전체 너비 바 대신 AOSP 알약 모양 스타일의 작업 표시줄을 적용합니다.</string>

    <!-- icons -->
    <string name="set_iconfix_title">아이콘 선명하게</string>
