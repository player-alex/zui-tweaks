    <string name="set_iconheadroom_title">아이콘 크기</string>
    <string name="set_iconheadroom_summary" formatted="false">아이콘을 얼마만큼의 크기로 그릴지 지정합니다. 115%가 실제 크기와 일치합니다.</string>

    <!-- keyboard -->
    <string name="set_altfix_title">오른쪽 Alt 임시 조치</string>
    <string name="set_altfix_summary">오른쪽 Alt에 의해 무시되는 입력을 임시로 복구합니다.</string>
    <string name="set_altdefer_title">키 입력 큐잉</string>
    <string name="set_altdefer_summary">키 입력에 큐잉을 적용하여, 언어 전환 중에 입력한 글자가 전환된 언어로 들어가게 합니다.</string>
    <string name="set_altdefertimeout_title">큐 대기 한도</string>
    <string name="set_altdefertimeout_summary">전환 신호가 오지 않아도 이 시간이 지나면 큐를 비웁니다.</string>

    <!-- tuning -->
    <string name="set_collapsedpx_title">숨었을 때 높이</string>
    <string name="set_collapsedpx_summary">숨은 상태에서 작업 표시줄이 남길 높이. 12까지는 화면에 아무것도 보이지 않습니다.</string>
    <string name="set_collapsedelay_title">작업 표시줄 숨김 딜레이</string>
    <string name="set_collapsedelay_summary">커서가 벗어난 뒤 작업 표시줄이 숨겨지기까지의 딜레이.</string>
    <string name="set_cursorhotzone_title">가상 커서 반응 영역</string>
    <string name="set_cursorhotzone_summary">숨겨진 영역에서 가상 터치패드 커서가 반응하여 작업 표시줄이 올라오게 하는 영역.</string>
    <string name="set_cursorkeepopen_title">가상 커서 유지 범위</string>
    <string name="set_cursorkeepopen_summary">작업 표시줄에서 가상 터치패드 커서가 얼마만큼 멀어져야 다시 숨겨지는지의 거리.</string>

    <string name="set_drawermovable_title">앱 목록 묶기</string>
    <string name="set_drawermovable_summary">앱 목록에서 아이콘을 길게 누르면 메뉴 대신 이동 모드가 됩니다.</string>
    <string name="set_folderui_title">앱 목록 폴더</string>
    <string name="set_folderui_summary">앱을 다른 앱 위에 놓으면 폴더가 됩니다. 앱 목록 묶기가 필요합니다.</string>
    <string name="set_drawerorder_title">사용자 지정 정렬</string>
    <string name="set_drawerorder_summary">가나다순 대신 직접 배치한 순서를 유지합니다. A-Z 스크롤러가 숨겨집니다.</string>

    <string name="set_drawerdragslop_title">앱 목록 재정렬 거리 임계값</string>
    <string name="set_drawerdragslop_summary">앱 목록에서 재정렬 시 얼마만큼 움직여야 위치가 교환되는지에 대한 값입니다.</string>
    <string name="set_folderdragslop_title">폴더 내부 재정렬 거리 임계값</string>
    <string name="set_folderdragslop_summary">폴더 내부에서 재정렬 시 얼마만큼 움직여야 위치가 교환되는지에 대한 값입니다.</string>
    <string name="set_groupzonepct_title">위치 교환 갭 임계값</string>
    <string name="set_groupzonepct_summary">위치를 교환하려는 대상이 되는 영역에 대한 임계값입니다. 클수록 폴더화되기 쉬워지고 작을수록 앱과 앱 사이로 삽입되기가 쉬워집니다.</string>

    <string name="set_secondaryhomeguard_title">홈 화면 보호</string>
    <string name="set_secondaryhomeguard_summary">외부 디스플레이의 홈이 태블릿 화면을 차지하면 원래 홈으로 되돌립니다.</string>
    <string name="set_virtualcursor_title">가상 커서 추적</string>
    <string name="set_virtualcursor_summary">가상 터치패드 커서가 화면 아래 끝에서 작업 표시줄을 다시 불러옵니다.</string>
    <string name="set_control_title">진단 브로드캐스트</string>
    <string name="set_control_summary">이 화면의 다시 불러오기가 런처에 닿게 합니다. 끄면 통로가 닫힙니다.</string>

